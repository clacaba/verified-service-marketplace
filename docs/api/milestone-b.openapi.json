  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "marketplace_session"
      }
    },
    "schemas": {
      "PropertyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "addressLine1",
          "addressLine2",
          "city",
          "region",
          "postalCode",
          "countryCode"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "addressLine1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "addressLine2": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "Recognized ISO region; structural validation, not geocoding."
          }
        }
      },
      "Property": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "addressLine1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "addressLine2": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "Recognized ISO region; structural validation, not geocoding."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Window": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startMinute",
          "endMinute"
        ],
        "properties": {
          "startMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1425,
            "multipleOf": 15
          },
          "endMinute": {
            "type": "integer",
            "minimum": 15,
            "maximum": 1440,
            "multipleOf": 15
          }
        }
      },
      "Schedule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeZone",
          "bufferMinutes",
          "minimumNoticeMinutes",
          "weekly",
          "exceptions"
        ],
        "properties": {
          "timeZone": {
            "type": "string",
            "example": "Asia/Manila"
          },
          "bufferMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "minimumNoticeMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10080
          },
          "weekly": {
            "type": "array",
            "maxItems": 42,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "day",
                "startMinute",
                "endMinute"
              ],
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "startMinute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1425,
                  "multipleOf": 15
                },
                "endMinute": {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 1440,
                  "multipleOf": 15
                }
              }
            }
          },
          "exceptions": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "windows"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "windows": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "$ref": "#/components/schemas/Window"
                  }
                }
              }
            }
          }
        }
      },
      "BookingCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serviceId",
          "propertyId",
          "startsAt"
        ],
        "properties": {
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "propertyId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Exact UTC/offset-bearing slot; within 30-day horizon."
          }
        }
      },
      "BookingDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "decline",
              "start",
              "complete",
              "cancel"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Required nonblank for decline/cancel."
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "propertyId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PendingProviderConfirmation",
              "Confirmed",
              "InProgress",
              "Completed",
              "Declined",
              "Expired",
              "CancelledByCustomer",
              "CancelledByProvider"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "type": "object",
            "description": "Immutable server-calculated service/property/timezone/buffer; nested keys PascalCase."
          }
        }
      }
    }
  }
}
