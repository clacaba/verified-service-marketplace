{
  "openapi": "3.0.3",
  "info": {
    "title": "Verified Service Marketplace — Properties, availability, bookings",
    "version": "0.1.0",
    "description": "Cookie-authenticated human API. Read alongside milestone-a.openapi.json for auth/CSRF/catalog. Fictional demo: no payments. Public slots advisory; create rechecks. Stored booking snapshot nested keys are PascalCase. Real PostgreSQL/browser acceptance remains pending."
  },
  "servers": [
    {
      "url": "http://localhost:5080"
    },
    {
      "url": "http://localhost:3000",
      "description": "Same-origin frontend proxy"
    }
  ],
  "security": [
    {
      "browserSession": []
    }
  ],
