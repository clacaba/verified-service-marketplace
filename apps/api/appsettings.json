{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;api",
  "Web": {
    "PublicOrigin": "http://localhost:3000"
  },
  "Email": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "From": "noreply@marketplace.example"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Storage": {
    "Endpoint": "http://localhost:9000",
    "Bucket": "verification-evidence"
  },
  "ServiceImages": { "Bucket": "service-images", "CleanupEnabled": false },
  "Scanner": {
    "Host": "localhost",
    "Port": 3310
  },
