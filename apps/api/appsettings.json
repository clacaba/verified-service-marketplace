    "DraftRetentionDays": 30,
    "SubmittedRetentionDays": 90,
    "AccessSeconds": 60,
    "RetentionEnabled": false,
    "IndividualRequired": [
      "Identity"
    ],
    "BusinessRequired": [
      "Identity",
      "BusinessRegistration"
    ],
    "TradeCategoryIds": [
      "10000000-0000-0000-0000-000000000002",
      "10000000-0000-0000-0000-000000000003"
    ],
    "TradeEvidence": "TradeQualification"
  }
